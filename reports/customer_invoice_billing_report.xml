<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_billing_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="cib_report_variant" t-value="'a4'"/>

                <style>
                    /* Base Document Styling */
                    .cib-page {
                        color: #222;
                        font-family: 'Segoe UI', Arial, sans-serif;
                        font-size: 13px;
                        line-height: 1.2;
                        margin: 0 auto;
                        max-width: 188mm;
                    }

                    .cib-page * {
                        box-sizing: border-box;
                    }

                    /* Header Layout */
                    .cib-header {
                        display: table;
                        width: 100%;
                        margin-bottom: 18px;
                        border-bottom: 2px solid #333;
                        padding-bottom: 12px;
                    }

                    .cib-header-left,
                    .cib-header-center,
                    .cib-header-right {
                        display: table-cell;
                        vertical-align: bottom;
                    }

                    .cib-header-left {
                        width: 30%;
                    }

                    .cib-header-center {
                        width: 40%;
                        text-align: center;
                        vertical-align: bottom;
                        padding-top: 4px;
                    }

                    .cib-header-right {
                        width: 30%;
                        text-align: left;
                        padding-top: 6px;
                    }

                    .cib-logo {
                        max-height: 110px;
                        max-width: 300px;
                        object-fit: contain;
                    }

                    .cib-company-small {
                        font-size: 12px;
                        color: #464646;
                        margin-top: 3px;
                        text-transform: uppercase;
                    }

                    .cib-company-title {
                        font-weight: 900;
                        font-size: 16px;
                        letter-spacing: 1px;
                        text-transform: uppercase;
                    }

                    .cib-title {
                        font-size: 14px;
                        font-weight: bold;
                        color: #555;
                        margin-top: 2px;
                        text-decoration: underline;
                        text-transform: uppercase;
                    }

                    /* Meta Data */
                    .cib-meta-row {
                        margin-bottom: 3px;
                        white-space: nowrap;
                    }

                    .cib-meta-label {
                        font-weight: bold;
                        color: #666;
                        font-size: 11px;
                        text-transform: uppercase;
                        display: inline-block;
                        width: 60px;
                    }

                    /* Tables Styling */
                    .cib-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 14px;
                        table-layout: fixed;
                    }

                    .cib-table th,
                    .cib-table td {
                        border: 1px solid #616161;
                        padding: 4px 6px;
                        vertical-align: middle;
                        overflow-wrap: anywhere;
                        font-size: 12px;
                        line-height: 1.05;
                    }

                    .cib-table th {
                        background: #f8f9fa;
                        font-weight: bold;
                        font-size: 12px;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                    }

                    .cib-info-table {
                        margin-bottom: 14px;
                    }

                    .cib-info-table th {
                        width: 25mm;
                        text-align: left;
                        font-weight: bold;
                    }

                    .cib-info-table td {
                        font-weight: normal;
                    }

                    .cib-invoice-table th {
                        text-align: center;
                    }

                    .cib-invoice-table td {
                        height: 18px;
                    }

                    .cib-text-center {
                        text-align: center;
                    }

                    .cib-text-right {
                        text-align: right;
                    }

                    /* Total Row */
                    .cib-total-row td {
                        background: #fdfdfe;
                        font-weight: bold;
                        font-size: 12px;
                        border-top: 2px solid #333;
                    }

                    /* Sections */
                    .cib-section {
                        margin-top: 12px;
                    }

                    .cib-section-title {
                        font-weight: bold;
                        font-size: 13px;
                        margin-bottom: 6px;
                    }

                    .cib-remark {
                        margin-top: 8px;
                        margin-bottom: 8px;
                    }

                    .cib-remark strong {
                        font-weight: bold;
                    }

                    .cib-bank-table {
                        margin-bottom: 12px;
                    }

                    .cib-bank-table th {
                        background: #fcfcfc;
                        font-size: 12px;
                        width: 36mm;
                        text-align: left;
                        white-space: nowrap;
                    }

                    .cib-bank-table td {
                        text-align: center;
                        font-size: 12px;
                    }

                    /* Contact Block */
                    .cib-contact-block {
                        display: table;
                        width: 100%;
                        margin-top: 10px;
                        margin-bottom: 18px;
                    }

                    .cib-contact-label,
                    .cib-contact-details {
                        display: table-cell;
                        vertical-align: top;
                        horizontal-align: left;
                    }

                    .cib-contact-label {
                        width: 25mm;
                        font-weight: bold;
                        font-size: 12px;
                        text-transform: uppercase;
                        color: #464646;
                    }

                    .cib-contact-line {
                        margin-bottom: 3px;
                        line-height: 1.1;
                    }

                    .cib-email {
                        color: #0056b3;
                        text-decoration: underline;
                    }

                    /* Signatures */
                    .cib-signatures {
                        display: table;
                        width: 100%;
                        margin-top: 40px;
                        page-break-inside: avoid;
                    }

                    .cib-signature-block {
                        display: table-cell;
                        width: 50%;
                        text-align: center;
                        vertical-align: bottom;
                    }

                    .cib-signature-title {
                        font-weight: bold;
                        margin-bottom: 40px;
                        text-transform: uppercase;
                    }

                    .cib-signature-line {
                        width: 70%;
                        margin: 0 auto 7px auto;
                        border-bottom: 1px solid #333;
                    }

                    .cib-signature-name {
                        font-weight: bold;
                        margin-bottom: 5px;
                    }

                    .cib-signature-position {
                        font-size: 12px;
                        color: #464646;
                    }
                    
                    .cib-footer-keep-together {
                        page-break-inside: avoid;
                        break-inside: avoid;
                        -webkit-column-break-inside: avoid;
                    }

                    .cib-footer-keep-together table,
                    .cib-footer-keep-together tbody,
                    .cib-footer-keep-together tr,
                    .cib-footer-keep-together td,
                    .cib-footer-keep-together th {
                        page-break-inside: avoid;
                        break-inside: avoid;
                    }

                    .cib-bank-table {
                        page-break-inside: avoid;
                        break-inside: avoid;
                    }

                    .cib-contact-block {
                        page-break-inside: avoid;
                        break-inside: avoid;
                    }

                    .cib-signatures {
                        page-break-inside: avoid;
                        break-inside: avoid;
                    }
                </style>

                <div t-att-class="'page cib-page cib-%s' % cib_report_variant">

                    <!-- HEADER -->
                    <div class="cib-header">
                        <div class="cib-header-left">
                            <img t-if="doc.company_id.logo"
                                t-att-src="image_data_uri(doc.company_id.logo)"
                                class="cib-logo"
                                alt="Company Logo"/>
                            <div class="cib-company-small">
                                <span t-esc="doc.company_id.name or ''"/>
                            </div>
                        </div>

                        <div class="cib-header-center">
                            <div class="cib-company-title">
                                <span t-esc="doc.company_id.name or ''"/>
                            </div>
                            <div class="cib-title">Invoice</div>
                        </div>

                        <div class="cib-header-right">
                            <div class="cib-meta-row">
                                <span class="cib-meta-label">Sq. No.</span>
                                <span>: </span>
                                <strong t-esc="doc.sequence_no or ''"/>
                            </div>
                            <div class="cib-meta-row">
                                <span class="cib-meta-label">Date</span>
                                <span>: </span>
                                <strong t-field="doc.billing_date"
                                        t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                            </div>
                        </div>
                    </div>

                    <!-- BILLING INFO -->
                    <table class="cib-table cib-info-table">
                        <tbody>
                            <tr>
                                <th>Bill To</th>
                                <td>
                                    <span t-esc="doc.bill_to_text or doc.partner_id.display_name or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <th>From</th>
                                <td>
                                    <span t-esc="doc._get_from_text()"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- INVOICE TABLE -->
                    <table class="cib-table cib-invoice-table">
                        <thead>
                            <tr>
                                <th style="width: 10mm;">No</th>
                                <th style="width: 20mm;">Date</th>
                                <th>Description</th>
                                <th style="width: 30mm;">Invoice ID</th>
                                <th style="width: 35mm;">Amount (KS)</th>
                                <th style="width: 20mm;">CPI</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.invoice_ids" t-as="invoice">
                                <tr>
                                    <td class="cib-text-center">
                                        <span t-esc="invoice_index + 1"/>
                                    </td>
                                    <td class="cib-text-center">
                                        <span t-field="invoice.invoice_date"
                                            t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                    </td>
                                    <td>
                                        <span t-esc="doc._get_invoice_vendor_ref(invoice)"/>
                                    </td>
                                    <td class="cib-text-center">
                                        <span t-esc="doc._get_invoice_anzer_id(invoice)"/>
                                    </td>
                                    <td class="cib-text-right">
                                        <span t-esc="'{:,.2f} {}'.format(invoice.amount_total or 0.0, doc.currency_id.symbol or 'K')"/>
                                    </td>
                                    <td class="cib-text-center">
                                        <span t-esc="doc._get_invoice_cpi(invoice)"/>
                                    </td>
                                </tr>
                            </t>

                            <tr class="cib-total-row">
                                <td colspan="4" class="cib-text-right">Total Amount</td>
                                <td class="cib-text-right">
                                    <span t-esc="'{:,.2f} {}'.format(doc.total_amount or 0.0, doc.currency_id.symbol or 'K')"/>
                                </td>
                                <td/>
                            </tr>
                        </tbody>
                    </table>
                    
                    <div class="cib-footer-keep-together">
                        <!-- REMARK -->
                        <t t-set="remark_text" t-value="doc._get_remark_text()"/>
                        <div class="cib-section cib-remark" t-if="remark_text">
                            <strong>Remark:</strong>
                            <span t-esc="remark_text"/>
                        </div>

                        <!-- BANK INFORMATION -->
                        <div class="cib-section" t-if="doc.bank_line_ids">
                            <div class="cib-section-title">Bank Information:</div>
                            <table class="cib-table cib-bank-table">
                                <tbody>
                                    <tr>
                                        <th>Account Number</th>
                                        <td t-foreach="doc.bank_line_ids" t-as="bank">
                                            <span t-esc="bank.account_number"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Account Name</th>
                                        <td t-foreach="doc.bank_line_ids" t-as="bank">
                                            <span t-esc="bank.account_name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Bank Name</th>
                                        <td t-foreach="doc.bank_line_ids" t-as="bank">
                                            <span t-esc="bank.bank_name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Currency</th>
                                        <td t-foreach="doc.bank_line_ids" t-as="bank">
                                            <span t-esc="bank.currency_name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="cib-footer-keep-together">
                        <!-- CONTACT -->
                        <div class="cib-contact-block">
                            <div class="cib-contact-label">Contact :</div>
                            <div class="cib-contact-details">
                                <div class="cib-contact-line" t-if="doc.contact_name">
                                    <strong t-esc="doc.contact_name"/>
                                </div>
                                <div class="cib-contact-line" t-if="doc.contact_phone">
                                    <span t-esc="doc.contact_phone"/>
                                </div>
                                <div class="cib-contact-line cib-email" t-if="doc.contact_email">
                                    <span t-esc="doc.contact_email"/>
                                </div>
                            </div>
                        </div>

                        <!-- SIGNATURES -->
                        <div class="cib-signatures">
                            <div class="cib-signature-block">
                                <div class="cib-signature-title">Approved By</div>
                                <div class="cib-signature-line"/>
                                <div class="cib-signature-name">
                                    <span t-esc="doc.approved_by_name or ''"/>
                                </div>
                                <div class="cib-signature-position">
                                    <span t-esc="doc.approved_by_position or ''"/>
                                </div>
                            </div>

                            <div class="cib-signature-block">
                                <div class="cib-signature-title">Prepared By</div>
                                <div class="cib-signature-line"/>
                                <div class="cib-signature-name">
                                    <span t-esc="doc.prepared_by_name or ''"/>
                                </div>
                                <div class="cib-signature-position">
                                    <span t-esc="doc.prepared_by_position or ''"/>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>

